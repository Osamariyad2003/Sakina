{
  "expo": {
    "name": "Sakina",
    "slug": "sakina",
    "scheme": "sakina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sakina.app"
    },
    "android": {
      "package": "com.sakina.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F1EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Thmanyah-Sans-Regular.otf",
            "./assets/fonts/Thmanyah-Sans-Medium.otf",
            "./assets/fonts/Thmanyah-Sans-Bold.otf",
            "./assets/fonts/Thmanyah-SerifDisplay-Regular.otf",
            "./assets/fonts/Thmanyah-SerifText-Regular.otf"
          ]
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F5F1EA",
          "dark": {
            "backgroundColor": "#1B1E1C"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "بدنا نستخدم المايكروفون عشان تقدر تحكي مع الرفيق بصوتك.",
          "speechRecognitionPermission": "بدنا نستخدم التعرف على الصوت عشان نحول حكيك لنص.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./plugins/withRiveAndroidVersion.js",
      "./plugins/withNdkVersion.js"
    ]
  }
}
